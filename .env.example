TYPESAFE_API_KEY=[api_key]
GEMINI_API_KEY=[api_key]
# Optional: Nemotron via any OpenAI-compatible endpoint (tried before Gemini when both are set)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_API_KEY=
NEMOTRON_ENABLE_THINKING=false
# Optional: AGNTCY SLIM channel that receives every (redacted) deliberation. See agntcy_slim.py.
SLIM_ENDPOINT=
SLIM_SHARED_SECRET=
SLIM_CHANNEL=agntcy/sherpa/deliberations
SLIM_OBSERVERS=agntcy/sherpa/observer
